{
  "name": "@raft/backend",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm run build && pnpm run \"/^watch:.*/\"",
    "watch:compile": "pnpm exec tsc --watch --preserveWatchOutput -p tsconfig.json",
    "watch:server": "node --watch dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@raft/shared": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
